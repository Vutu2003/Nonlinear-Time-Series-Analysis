\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces Bằng chứng PPI ký hiệu thăm dò tại (A) 60, (B) 120 và (C) 180 s. Tỷ lệ xuất hiện 0V/2V theo session-trạng thái ghép cặp sử dụng lượng tử hóa PPI sáu mức và từ chồng lấp ba ký hiệu. Thay đổi trung vị 0V dương và 2V âm, nhưng không kiểm định nào trong chín kiểm định phân loại--thời lượng, kể cả 1V trong Bảng\nobreakspace  {}\ref  {tab:supp_symbolic}, đạt BH3 trong thời lượng. Các tỷ lệ cung cấp bối cảnh hỗ trợ, không phải hoạt động giao cảm/phế vị trực tiếp.\relax }}{37}{figure.caption.10}\protected@file@percent }
\newlabel{fig:supp_symbolic}{{S10}{37}{Bằng chứng PPI ký hiệu thăm dò tại (A) 60, (B) 120 và (C) 180 s. Tỷ lệ xuất hiện 0V/2V theo session-trạng thái ghép cặp sử dụng lượng tử hóa PPI sáu mức và từ chồng lấp ba ký hiệu. Thay đổi trung vị 0V dương và 2V âm, nhưng không kiểm định nào trong chín kiểm định phân loại--thời lượng, kể cả 1V trong Bảng~\ref {tab:supp_symbolic}, đạt BH3 trong thời lượng. Các tỷ lệ cung cấp bối cảnh hỗ trợ, không phải hoạt động giao cảm/phế vị trực tiếp.\relax }{figure.caption.10}{}}
